name: Cleanup Old PRs - Inactive Users

on:
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write

env:
  # SAFETY SWITCH
  # true  = report/comment only
  # false = actually close eligible PRs
  DRY_RUN: "true"

jobs:
  cleanup:
    name: Find and Cleanup Old PRs
    runs-on: ubuntu-latest

    steps:

      # ---------------------------------------------------------
      # 1. Check environment
      # ---------------------------------------------------------

      - name: Show configuration
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          echo "=========================================="
          echo "PR Cleanup Configuration"
          echo "=========================================="
          echo "Repository   : ${{ github.repository }}"
          echo "Organization : ${{ github.repository_owner }}"
          echo "DRY_RUN      : ${DRY_RUN}"
          echo "=========================================="

      # ---------------------------------------------------------
      # 2. Find and process PRs
      # ---------------------------------------------------------

      - name: Process Pull Requests
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail

          REPO="${{ github.repository }}"
          ORG="${{ github.repository_owner }}"

          echo ""
          echo "Repository: ${REPO}"
          echo "Organization: ${ORG}"
          echo ""

          # -----------------------------------------------------
          # Calculate 180-day cutoff
          # -----------------------------------------------------

          CUTOFF_DATE=$(date -u -d "180 days ago" +"%Y-%m-%dT%H:%M:%SZ")

          echo "PRs created before:"
          echo "${CUTOFF_DATE}"
          echo ""

          # -----------------------------------------------------
          # Counters
          # -----------------------------------------------------

          TOTAL=0
          OLD=0
          ACTIVE=0
          INACTIVE=0
          KEEP_OPEN=0
          SKIPPED=0
          WOULD_CLOSE=0
          CLOSED=0
          COMMENTS_ADDED=0

          # -----------------------------------------------------
          # Get all OPEN PRs
          # -----------------------------------------------------

          echo "Getting open PRs..."

          gh pr list \
            --repo "${REPO}" \
            --state open \
            --limit 1000 \
            --json number,title,author,createdAt,labels,url \
            > prs.json

          TOTAL=$(jq 'length' prs.json)

          echo "Total open PRs: ${TOTAL}"
          echo ""

          # -----------------------------------------------------
          # Process every PR
          # -----------------------------------------------------

          while read -r PR; do

            PR_NUMBER=$(echo "${PR}" | jq -r '.number')
            PR_TITLE=$(echo "${PR}" | jq -r '.title')
            AUTHOR=$(echo "${PR}" | jq -r '.author.login // empty')
            CREATED_AT=$(echo "${PR}" | jq -r '.createdAt')
            PR_URL=$(echo "${PR}" | jq -r '.url')

            echo ""
            echo "=========================================="
            echo "PR #${PR_NUMBER}"
            echo "=========================================="
            echo "Title   : ${PR_TITLE}"
            echo "Author  : ${AUTHOR}"
            echo "Created : ${CREATED_AT}"
            echo "URL     : ${PR_URL}"

            # ---------------------------------------------------
            # Check PR age
            # ---------------------------------------------------

            if [[ "${CREATED_AT}" > "${CUTOFF_DATE}" ]]; then

              echo "Result  : SKIP"
              echo "Reason  : PR is less than 180 days old"

              SKIPPED=$((SKIPPED + 1))

              continue
            fi

            OLD=$((OLD + 1))

            echo "Age     : Older than 180 days"

            # ---------------------------------------------------
            # Check keep-open label
            # ---------------------------------------------------

            HAS_KEEP_OPEN=$(echo "${PR}" | jq -r '
              any(
                .labels[];
                (.name | ascii_downcase) == "keep-open"
              )
            ')

            if [[ "${HAS_KEEP_OPEN}" == "true" ]]; then

              echo "Result  : SKIP"
              echo "Reason  : keep-open label exists"

              KEEP_OPEN=$((KEEP_OPEN + 1))

              continue
            fi

            # ---------------------------------------------------
            # Check author
            # ---------------------------------------------------

            if [[ -z "${AUTHOR}" || "${AUTHOR}" == "null" ]]; then

              echo "Result  : SKIP"
              echo "Reason  : Unable to determine PR author"

              SKIPPED=$((SKIPPED + 1))

              continue
            fi

            # ---------------------------------------------------
            # Check organization membership
            # ---------------------------------------------------

            echo "Checking organization membership..."

            MEMBERSHIP_STATUS=$(curl -s \
              -o /dev/null \
              -w "%{http_code}" \
              -H "Accept: application/vnd.github+json" \
              -H "Authorization: Bearer ${GH_TOKEN}" \
              -H "X-GitHub-Api-Version: 2022-11-28" \
              "https://api.github.com/orgs/${ORG}/members/${AUTHOR}")

            case "${MEMBERSHIP_STATUS}" in

              204)

                echo "Author  : ACTIVE organization member"
                echo "Result  : SKIP"

                ACTIVE=$((ACTIVE + 1))

                continue
                ;;

              404)

                echo "Author  : NOT an organization member"

                INACTIVE=$((INACTIVE + 1))

                ;;

              *)

                echo "Membership API returned HTTP ${MEMBERSHIP_STATUS}"
                echo "Result  : SKIP"
                echo "Reason  : Unable to verify organization membership"

                SKIPPED=$((SKIPPED + 1))

                continue
                ;;

            esac

            # ---------------------------------------------------
            # Candidate found
            # ---------------------------------------------------

            WOULD_CLOSE=$((WOULD_CLOSE + 1))

            echo ""
            echo "******** CLEANUP CANDIDATE ********"
            echo "PR       : #${PR_NUMBER}"
            echo "Author   : ${AUTHOR}"
            echo "Created  : ${CREATED_AT}"
            echo "Action   : Would close"
            echo "***********************************"
            echo ""

            # ---------------------------------------------------
            # Create/update PR comment
            # ---------------------------------------------------

            COMMENT_BODY=$(cat <<EOF
<!-- pr-cleanup-bot -->

🤖 **PR Cleanup — Dry Run**

This PR has been identified as a cleanup candidate.

| Check | Result |
|---|---|
| PR age | > 180 days |
| Author | \`${AUTHOR}\` |
| Organization member | ❌ No |
| \`keep-open\` label | ❌ No |
| Action | Would close this PR |
| Dry run | ✅ Enabled |

**No changes have been made.**

This PR would be closed when the workflow is run with:

\`DRY_RUN=false\`

> If this PR should remain open, add the **keep-open** label.
EOF
)

            # ---------------------------------------------------
            # Check if bot comment already exists
            # ---------------------------------------------------

            EXISTING_COMMENT=$(gh api \
              "repos/${REPO}/issues/${PR_NUMBER}/comments" \
              --paginate \
              --jq '.[] | select(.body | contains("<!-- pr-cleanup-bot -->")) | .id' \
              | head -n 1 || true)

            if [[ -n "${EXISTING_COMMENT}" ]]; then

              echo "Updating existing cleanup comment..."

              gh api \
                --method PATCH \
                "repos/${REPO}/issues/comments/${EXISTING_COMMENT}" \
                -f body="${COMMENT_BODY}"

            else

              echo "Creating cleanup comment..."

              gh pr comment "${PR_NUMBER}" \
                --repo "${REPO}" \
                --body "${COMMENT_BODY}"

              COMMENTS_ADDED=$((COMMENTS_ADDED + 1))

            fi

            # ---------------------------------------------------
            # Close PR only when DRY_RUN=false
            # ---------------------------------------------------

            if [[ "${DRY_RUN}" == "true" ]]; then

              echo ""
              echo "[DRY RUN] PR #${PR_NUMBER} was NOT closed."

            else

              echo ""
              echo "Closing PR #${PR_NUMBER}..."

              gh pr close "${PR_NUMBER}" \
                --repo "${REPO}" \
                --comment \
                "This PR was automatically closed because it has been open for more than 180 days and was created by a user who is no longer an active organization member."

              CLOSED=$((CLOSED + 1))

              echo "PR #${PR_NUMBER} closed."

            fi

          done < <(jq -c '.[]' prs.json)
